# Plantilla de configuración local. Copie este archivo a ".env" (que Git ignora) y ajuste los valores.
#   Windows (PowerShell):  Copy-Item .env.example .env ; . .\script.ps1
#
# NUNCA ponga aquí credenciales reales de un ambiente compartido: estos valores son solo para el
# contenedor Oracle local de docker-compose.yml.

# --- Oracle local (los lee docker-compose.yml y los workers de Spark) --------------------------------
# Contraseña de SYS y SYSTEM dentro del contenedor.
ORACLE_PASSWORD=oracle_local_admin

# Conexión de los jobs de Spark. Estos son los valores por defecto del código; solo DB_PASSWORD es obligatoria.
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_USER=bigdata
DB_PASSWORD=bigdata_local
# Esquema dueño de las tablas; vacío = el del usuario.
DB_SCHEMA=
